    // zero would do nothing, so Enhance goes to 100 % then, and back to zero when Classic returns.
    uen = floor(slider25 + 0.5);
    uen = uen == 0 ? ((ext_enh & 1) ? 1 : 2) : uen == 1 ? ((ext_enh & 2) ? 2 : 0) : 0;
    uen > 0 && slider17 < 0.5 ? ( slider17 = 100; uenauto = 1; );
    uen == 0 && uenauto ? ( slider17 = 0; uenauto = 0; );
    slider25 = uen; slider_automate(16777216 + 65536); slider_automate(16777216 + 65536, 1);
  ) : uhov == 33 ? (
    slider24 = slider24 >= 0.5 ? 0 : 1; slider_automate(8388608); slider_automate(8388608, 1);
  ) : uhov == 32 ? (
    // open the spectrum display or fold it away. The analyzer itself stays as it is: off, unless it was switched on
    // with its own button in the display
    slider23 = ufold ? 1 : 0;
    slider_automate(4194304); slider_automate(4194304, 1);
  ) : uhov == 31 ? (
    slider22 = uana ? 0 : 1; slider_automate(2097152); slider_automate(2097152, 1);
  ) : uhov > 100 ? (
    uedit = uhov-100; strcpy(#uedit, "");
  );
);
(ulb && udrag) ? (
  mouse_y != udy ? (
    udacc += (udy-mouse_y)/max(1, udh)*((mouse_cap & 8) ? 0.2 : 1);
    udacc = max(0, min(1, udacc));
    udy = mouse_y;
    uset(udrag, floor(uval(udrag, udacc)*10+0.5)/10);
  );
  uhov = udrag;
);
(urelease && udrag) ? ( slider_automate(umask(udrag), 1); udrag = 0; );
mouse_wheel != 0 ? (
  uisf ? (
    uset(uhov, floor(uval(uhov, upos(uhov) + (mouse_wheel > 0 ? 1 : -1)*((mouse_cap & 8) ? 0.002 : 0.01))*10+0.5)/10);
    slider_automate(umask(uhov), 1);
  );
  mouse_wheel = 0;
);
ulbp = ulb;
uhovp = uhov;

// ---- footer (the same in every dmajorsound plug-in): what the control under the mouse does, a dividing line,
// below it the version on the left and dmajorsound.com in the right corner
ucol(udark ? ucHAIR : ucBORD, 1); gfx_rect(uox, floor(uyf+20*usc), floor(680*usc), 1);
ufcy = floor(uyf+32*usc);
gfx_setfont(9);
sprintf(#uver, "V %s - developed with AI assistance", #verstr);
gfx_measurestr(#uver, ulgw, ulgh);
ucol(ucMUTED, 1); gfx_x = uox+16*usc; gfx_y = floor(ufcy - ulgh/2); gfx_drawstr(#uver);
// a newer Alfred has been released (the plug-in asks GitHub once per session and sets ext_update): as in OLAAF,
// right of the version a light red dot that blinks every 0.7 s and "0.41 is out" in red, in the footer's type;
// a click opens the download page
ext_update >= 0.5 ? (
  sprintf(#uupd, "%d.%d is out", ext_upd_a, ext_upd_b);
  sprintf(#uupt, "Alfred %d.%d beta is out. Click to open the download page.", ext_upd_a, ext_upd_b);
  gfx_measurestr(#uupd, uunw, uunh);
  uudr = 3.5*usc;
  uudx = floor(uox+16*usc + ulgw + 8*usc) + uudr; uudy = ufcy;
  ucol(0xF06E6E, 1);
  gfx_circle(uudx, uudy, uudr, (floor(time_precise()/0.7) % 2) == 0, 1);
  udark ? (gfx_r = 1; gfx_g = 0x7A/255; gfx_b = 0x6E/255) : (gfx_r = 0xC8/255; gfx_g = 0x42/255; gfx_b = 0x3B/255);
  gfx_x = floor(uudx + uudr + 4*usc); gfx_y = floor(ufcy - uunh/2); gfx_drawstr(#uupd);
  uupx = floor(uudx - uudr - 4*usc); uupy = floor(ufcy - 9*usc);
  uupw = floor(gfx_x + 4*usc) - uupx; uuph = floor(18*usc);
  gfx_a = 1;
) : ( uupw = 0; );
gfx_a = 1; ucol(ucMUTED, 1);
gfx_measurestr("dmajorsound.com", ulgw, ulgh);
// the dmajorsound mark sits in the bottom right corner, "dmajorsound.com" to its left, both on one center line
ulmw = usc >= 1.5 ? lgw2 : lgw1;
gfx_x = floor(uox+664*usc - ulmw - 6*usc - ulgw); gfx_y = floor(ufcy - ulgh/2); gfx_drawstr("dmajorsound.com");
ucol(ucMUTED, 1); ulogo(floor(uox+664*usc), ufcy);
gfx_a = 1;
gfx_setfont(2);
ucol(ucMUTED, 1);
gfx_x = uox+16*usc; gfx_y = floor(uyf);
uhov == 1 ? gfx_drawstr("Signal: level of the sound you want to keep.") :
uhov == 2 ? gfx_drawstr(slider20 >= 0.5 ? "Noise: level of the steady background noise." : "Noise: level of everything that is not the voice.") :
uhov == 3 ? gfx_drawstr("Reverb: level of the room tail behind the sound.") :
uhov >= 4 && uhov <= 6 ? gfx_drawstr("Solo: hear this part alone. Shift-click adds another part, e.g. Noise + Reverb.") :
uhov >= 7 && uhov <= 9 ? gfx_drawstr("Mute: silence this part.") :
uhov >= 10 && uhov <= 12 ? gfx_drawstr("Delta: hear only what this fader takes away from its part.") :
uhov == 20 ? gfx_drawstr("Power: bypass. The delay stays compensated.") :
uhov == 21 ? gfx_drawstr("Adaptive: drop the noise print and follow the noise floor.") :
uhov == 22 ? gfx_drawstr(pmode == 1 ? "Listening. Click again to stop and keep the noise print." : "Learn: click, play only the noise, click again. Alt-click clears the print.") :
uhov == 23 ? gfx_drawstr("Basic tab: three levels with solo and mute.") :
uhov == 24 ? gfx_drawstr("Expert tab: noise print, thresholds, Enhance and Preserve Transients.") :
uhov == 26 ? gfx_drawstr("Reset: all faders back to their defaults. The noise print stays.") :
uhov == 27 ? gfx_drawstr(udark ? "Dark mode. Click for light." : "Light mode. Click for dark.") :
uhov == 30 ? gfx_drawstr(uana ? "Gray: input. Colors: what you hear of each part." : "The analyzer is off. The faders and meters still work.") :
uhov == 34 ? gfx_drawstr(#uupt) :
uhov == 35 ? gfx_drawstr(ext_enh_load >= 0.5 ? "Loading the Enhance model ..." : ext_enh_on < 0.5 ? "Enhance: classic. Click for Restore or Sidon (studio voice, not real time)." : slider25 < 1.5 ? "Restore: studio voice. Not real time: play a passage twice to hear it. Renders include it." : "Sidon: voice built anew, slow. Not real time: play a passage twice to hear it. Renders include it.") :
uhov == 33 ? gfx_drawstr(ext_neural == 2 ? "Neural voice engine: not available (needs 48 kHz and its installed files)." : slider20 >= 0.5 ? "Neural voice engine: works in Voice mode only." : slider24 >= 0.5 ? "Neural voice engine is on (needs more CPU, 60 ms more delay). Click for the classic engine." : "Classic engine is on (real time, light on CPU). Click for the neural voice engine.") :
uhov == 32 ? gfx_drawstr(ufold ? "Spectrum: click to open the display. The analyzer stays off until you switch it on there." : "Spectrum: click to fold the display away.") :
uhov == 31 ? gfx_drawstr(uana ? "Analyzer: click to switch the spectrum off and save CPU." : "Analyzer: off, it costs no CPU. Click to show the spectrum.") :
uhov == 40 ? gfx_drawstr("Noise threshold: higher treats more as noise, lower keeps more.") :
uhov == 41 ? gfx_drawstr("Tonal threshold: higher removes more hum and steady tones, lower protects tonal sounds.") :
uhov == 50 ? gfx_drawstr("Band threshold 20 - 120 Hz: up cleans harder here, down keeps more.") :
uhov == 51 ? gfx_drawstr("Band threshold 120 - 500 Hz: up cleans harder here, down keeps more.") :
uhov == 52 ? gfx_drawstr("Band threshold 500 Hz - 2 kHz: up cleans harder here, down keeps more.") :
uhov == 53 ? gfx_drawstr("Band threshold 2 - 6 kHz: up cleans harder here, down keeps more.") :
uhov == 54 ? gfx_drawstr("Band threshold 6 - 20 kHz: up cleans harder here, down keeps more.") :
uhov == 61 ? gfx_drawstr("Preserve Transients: keeps hits and clicks through the cleaning. Above 50 % also single bands.") :
uhov == 28 ? gfx_drawstr("Voice: keeps the voice, treats everything else as noise. The dot lights on a voice.") :
uhov == 29 ? gfx_drawstr("SFX: keeps any sound and removes only the steady noise.") :
uhov > 100 ? gfx_drawstr("Click to type a value. Enter sets it, Esc leaves it.") :
uhov == 60 ? gfx_drawstr("Enhance: moves the voice toward a close studio tone. Cuts rumble, boom and dullness.") :
