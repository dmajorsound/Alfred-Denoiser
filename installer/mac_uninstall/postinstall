#!/bin/sh
# Alfred uninstaller: removes the plug-ins (VST3, AU, CLAP) and the engine and model files that the installer put
# into the system folders, also copies in the user's own plug-in folders, and makes macOS forget the installs.
for d in "/Library/Audio/Plug-Ins" ; do
  rm -rf "$d/VST3/Alfred.vst3" "$d/Components/Alfred.component" "$d/CLAP/Alfred.clap"
done
USER_NAME=$(stat -f%Su /dev/console)
USER_HOME=$(dscl . -read "/Users/$USER_NAME" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
if [ -n "$USER_HOME" ] && [ -d "$USER_HOME/Library/Audio/Plug-Ins" ]; then
  P="$USER_HOME/Library/Audio/Plug-Ins"
  rm -rf "$P/VST3/Alfred.vst3" "$P/Components/Alfred.component" "$P/CLAP/Alfred.clap"
fi
rm -rf "/Library/Application Support/dmajorsound/Alfred"
rmdir "/Library/Application Support/dmajorsound" 2>/dev/null
for id in vst3 au clap support restore sidon uninstall; do
  pkgutil --forget "com.dmajorsound.alfred.$id" >/dev/null 2>&1
done
# the Audio Unit list of the system is read again the next time a host starts
killall -9 AudioComponentRegistrar >/dev/null 2>&1
exit 0
